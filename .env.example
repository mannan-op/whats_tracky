# HTTP port. Render and most hosts inject PORT.
PORT=3000

# SQLite file. On a host with a persistent disk, point this at the mount.
DATABASE_PATH=./data/budget.db

# Shown on every amount. Examples: PKR, USD, EUR, INR.
CURRENCY=PKR

# IANA timezone for "today", weekdays, and reports.
TZ=Asia/Karachi

# Public origin of this server, no trailing slash.
# Used to verify Twilio signatures. Example: https://abcd.ngrok-free.app
PUBLIC_URL=

# Twilio WhatsApp sandbox. Replies are TwiML, so the account SID is not read.
# Auth token turns on X-Twilio-Signature checks. Leave blank only for local experiments.
TWILIO_AUTH_TOKEN=
# Sandbox sender, for your own notes. Default sandbox number is +1 415 523 8886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API.
# VERIFY_TOKEN is a string you invent and paste into the Meta webhook form.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Recommended. Validates X-Hub-Signature-256 on incoming posts.
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Optional. Parsing and advice work with no key.
# When set, unknown messages are parsed with the model, and `advice` is rewritten in a friendlier tone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# CLI identity when you run `npm run cli`.
CLI_USER=me
