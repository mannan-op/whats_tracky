# HTTP port. Render and most hosts inject PORT.
PORT=3000

# Hosted libSQL. When TURSO_DATABASE_URL is set, the server uses that database and ignores DATABASE_PATH.
# TURSO_AUTH_TOKEN is required for Turso cloud. Leave both blank for the local CLI and tests.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SQLite file used when TURSO_DATABASE_URL is unset. Default ./data/budget.db.
DATABASE_PATH=./data/budget.db

# Shown on every amount. Examples: PKR, USD, EUR, INR.
CURRENCY=PKR

# IANA timezone for "today", weekdays, and reports.
TZ=Asia/Karachi

# Public origin of this server, no trailing slash.
# Example: https://your-app.onrender.com
PUBLIC_URL=

# Meta WhatsApp Cloud API. This is the hosted transport.
# VERIFY_TOKEN is a string you invent and paste into the Meta webhook form.
META_VERIFY_TOKEN=
# Permanent system user token. A temporary token from API Setup expires in about 24 hours.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Validates X-Hub-Signature-256 on incoming posts.
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Optional Twilio WhatsApp sandbox. Replies are TwiML, so the account SID is not read.
# Auth token turns on X-Twilio-Signature checks. Leave blank when you only use Meta.
TWILIO_AUTH_TOKEN=
# Sandbox sender, for your own notes. Default sandbox number is +1 415 523 8886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional. Parsing and advice work with no key.
# When set, unknown messages are parsed with the model, and `advice` is rewritten in a friendlier tone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# CLI identity when you run `npm run cli`.
CLI_USER=me
